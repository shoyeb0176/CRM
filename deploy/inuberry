#!/usr/bin/env bash
# Admin commands inside the container:
#   docker compose exec app inuberry make-admin you@company.com
#   docker compose exec app inuberry migrate
#   docker compose exec app inuberry version
set -euo pipefail
cd /app
case "${1:-}" in
  make-admin)
    [ -n "${2:-}" ] || { echo "Usage: inuberry make-admin you@company.com"; exit 1; }
    : "${DATABASE_URL:?Set DATABASE_URL in .env first}"
    ADMIN_EMAIL="$2" bash scripts/db-bootstrap.sh ;;
  migrate)
    : "${DATABASE_URL:?Set DATABASE_URL in .env first}"
    bash scripts/db-migrate.sh ;;
  version)
    node -e "fetch('http://localhost:'+(process.env.PORT||3000)+'/api/public/version').then(r=>r.json()).then(j=>console.log(j.version))" ;;
  *)
    echo "inuberry make-admin <email> | migrate | version" ;;
esac
