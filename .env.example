# Inuberry environment variables.
# Copy to `.env` for local runs, pass to Docker with `--env-file`, or set as Lovable secrets.
# VITE_* values are PUBLIC: they are baked into the browser bundle at build time. Never put secrets in them.
# Everything else is server-only and read at request time.

# ---------------------------------------------------------------- Supabase (required)
# Project URL and keys: Supabase dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
VITE_SUPABASE_PROJECT_ID=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon / publishable key>
# Secret: full database access. Server only.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ---------------------------------------------------------------- App
# Public address of this install; used in emails and redirects.
SITE_URL=https://crm.example.com
# Port for `bun run start` / the Docker image (Node build only).
PORT=3000
# Update check for self-hosted installs (platform owner sees "Update available").
UPDATE_FEED_URL=https://api.github.com/repos/ikyorince101/craft-core-os-7b21dda2/releases/latest

# ---------------------------------------------------------------- Encryption (strongly recommended)
# Encrypts stored AI keys and company SMTP passwords. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Set once and never change it: values saved with one key can't be read with another.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------- Stripe (billing)
# Direct Stripe (your own account). When STRIPE_SECRET_KEY is set it is used instead of Lovable's connector.
# sk_test_… for sandbox, sk_live_… for real payments.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<SITE_URL>/api/public/payments/webhook (whsec_…).
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_test_… / pk_live_…). Public.
VITE_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------- AI
# Instance default AI used by companies that haven't added their own key (Settings → AI).
# Tried in order, skipping any that isn't set: OpenAI → OpenRouter → Lovable AI (on Lovable only).
# If one fails (bad key, no credit, rate limit), the next one answers.
OPENAI_API_KEY=
# Optional, default gpt-6-luna.
OPENAI_MODEL=
# Optional. Reasoning models (gpt-5 / gpt-6) use OpenAI's Responses API so they can reason while
# using tools; set to "off" to use Chat Completions only.
OPENAI_RESPONSES_API=
# Any OpenAI-compatible endpoint works; OpenRouter by default. openrouter/free = free models.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional: force one model for the instance default (otherwise each feature's chosen model is used).
OPENROUTER_MODEL=

# ---------------------------------------------------------------- Sign-in
# "native" = Google sign-in through your own Supabase Auth Google provider.
# Leave empty on Lovable (uses Lovable's sign-in broker).
VITE_OAUTH_MODE=

# ---------------------------------------------------------------- Lovable (only while hosted on Lovable)
# Lovable sets these itself. Off Lovable, leave them empty: features fall back to the settings above.
LOVABLE_API_KEY=
LOVABLE_SEND_URL=
# Legacy Lovable Stripe connector ids and webhook secrets (used only when STRIPE_SECRET_KEY is empty).
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
VITE_PAYMENTS_CLIENT_TOKEN=

# Product analytics (public IDs, both optional; nothing loads until a visitor accepts optional cookies).
# PostHog EU Cloud, inside the app: Project settings › Project API key (starts phc_) and host.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Google Analytics 4, public website only: Admin › Data streams › Measurement ID (starts G-).
VITE_GA_MEASUREMENT_ID=
