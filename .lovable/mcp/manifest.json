      {
        "name": "create_lead",
        "title": "Create a lead",
        "description": "Propose a new sales lead. Follows the workspace's AI approval policy (usually a person approves it in Inuberry first).",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Person or lead name"
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "phone": {
              "type": "string",
              "maxLength": 50
            },
            "company_name": {
              "type": "string",
              "maxLength": 200
            },
            "job_title": {
              "type": "string",
              "maxLength": 200
            },
            "estimated_value": {
              "type": "number",
              "minimum": 0
            },
            "notes": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_company",
        "title": "Create a company",
        "description": "Propose a new customer company (an existing company with the same name is reused). Follows the approval policy.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
