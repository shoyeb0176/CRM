            },
            "description": {
              "type": "string",
              "maxLength": 4000
            },
            "type": {
              "type": "string",
              "enum": [
                "call",
                "email",
                "meeting",
                "note",
                "follow_up",
                "task"
              ]
            }
          },
          "required": [
            "entity_type",
            "entity_id",
            "title"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_agent",
        "title": "Create an AI agent",
        "description": "Propose an Inuberry AI agent that does a job by hand, on a schedule or when something happens. Ask the user what it should do, which data it may use, when it runs and what needs their OK first. Always waits for a person to approve it in Inuberry.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 500
            },
            "instructions": {
              "type": "string",
              "minLength": 10,
              "maxLength": 8000,
              "description": "What it does on every run, its rules and tone"
            },
            "modules": {
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "module": {
                    "type": "string",
                    "enum": [
                      "crm",
                      "sales",
                      "invoices",
                      "payments",
                      "inventory",
                      "purchasing",
                      "accounting",
                      "projects",
                      "hr",
                      "reports"
                    ]
                  },
                  "read": {
                    "type": "boolean"
                  },
                  "create": {
                    "type": "boolean"
                  },
                  "update": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "module"
                ]
              }
            },
            "tools": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tool names, e.g. invoice_search, crm_list_deals, crm_add_note, task_create, notification_create, send_email, team_chat_post"
            },
            "triggers": {
              "maxItems": 5,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "manual"
                      }
                    },
                    "required": [
                      "type"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "scheduled"
                      },
                      "config": {
                        "type": "object",
                        "properties": {
                          "every": {
                            "type": "string",
                            "enum": [
                              "hour",
                              "day",
                              "weekday",
                              "week"
                            ]
                          },
                          "at": {
                            "description": "HH:MM",
                            "type": "string"
                          },
                          "day": {
                            "description": "0 = Sunday",
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 6
                          },
                          "tz": {
                            "type": "string"
                          },
                          "prompt": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "every"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "config"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "event_based"
                      },
                      "config": {
                        "type": "object",
                        "properties": {
                          "event": {
                            "type": "string",
                            "description": "alert.invoice_overdue, alert.deal_stale, alert.low_stock, alert.task_overdue, crm.lead, forms.form, support.support_ticket, sales.quote_response, invoices.paid, hr.leave_request"
                          },
                          "prompt": {
                            "type": "string",
                            "maxLength": 2000
                          }
                        },
                        "required": [
                          "event"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "config"
                    ]
                  }
                ]
              }
            },
            "activate": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "instructions",
            "modules",
            "tools"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "get_action_status",
        "title": "Check a proposed change",
        "description": "Status of a change proposed by create_* or log_activity: pending, approved/executed (with the result), rejected or failed.",
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "action_id": {
